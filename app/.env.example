# Copie para .env.local e preencha com os dados do projeto Supabase
# (Project Settings > API). Sem essas variáveis o app roda em MODO DEMONSTRAÇÃO,
# com dados salvos apenas no navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Só para publicar uma demonstração SEM dados reais, remova as duas variáveis
# acima e habilite explicitamente. Produção sem backend falha por padrão.
# VITE_DEMO_MODE=true
